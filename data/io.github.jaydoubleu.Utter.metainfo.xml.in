<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>Utter</name>
  <summary>Dictate into any app</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.jaydoubleu">
    <name>Jay W</name>
  </developer>
  <description>
    <p>
      Utter turns speech into text and types it into the focused application.
      Recognition runs on your device with NVIDIA Parakeet, NVIDIA Nemotron or OpenAI Whisper models.
      No audio leaves your computer.
    </p>
    <ul>
      <li>Global shortcut with toggle or push-to-talk activation</li>
      <li>Types the text into any app, or pastes it</li>
      <li>Live text while you speak with Parakeet and Nemotron models</li>
      <li>An optional GNOME Shell extension shows the live text in a panel above all windows</li>
      <li>Spoken punctuation and a personal dictionary</li>
      <li>Optional cleanup with a local or cloud language model</li>
      <li>Dictation history</li>
    </ul>
  </description>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <caption>The main window with the recent dictations</caption>
      <image>https://raw.githubusercontent.com/JayDoubleu/Utter/main/docs/screenshots/main-window.png</image>
    </screenshot>
    <screenshot>
      <caption>The overlay panel shows the live text while you speak</caption>
      <image>https://raw.githubusercontent.com/JayDoubleu/Utter/main/docs/screenshots/overlay-desktop.png</image>
    </screenshot>
    <screenshot>
      <caption>Choose a speech model that runs on your computer</caption>
      <image>https://raw.githubusercontent.com/JayDoubleu/Utter/main/docs/screenshots/preferences-voice.png</image>
    </screenshot>
    <screenshot>
      <caption>Optional cleanup with a local or cloud language model</caption>
      <image>https://raw.githubusercontent.com/JayDoubleu/Utter/main/docs/screenshots/preferences-cleanup.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/JayDoubleu/Utter</url>
  <url type="bugtracker">https://github.com/JayDoubleu/Utter/issues</url>
  <url type="vcs-browser">https://github.com/JayDoubleu/Utter</url>
  <content_rating type="oars-1.1"/>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.1.0" date="2026-09-16">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
